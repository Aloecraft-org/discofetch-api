-- df/rooms -- rooms: TTL'd presence sets held in memory, and the two header tables that keep their answers uncached
--
-- Extracted from supervisor.lua at B0. The body is unchanged apart from
-- reaching shared state through the context, which a module cannot take from
-- a main-chunk upvalue.
--
-- ====================================================== the surface block
--
-- Entry points:   M.init(ctx) once, before anything below is called
--                 M.ROOMS
--                 M.ROOMS_GLOBAL_MAX
--                 M.room_prune
--                 M.room_list
--                 M.room_join
--                 M.PUBLIC_READ
--                 M.NO_STORE
--                 M.room_allowed
--                 M.valid_room
--                 M.ENDPOINT_KINDS
--                 M.room_claim   M.room_by_code   M.canon_code
--                 M.rooms_count
--
-- The context is read at CALL time, not at init: `db` is not open when a
-- module loads -- it arrives when migrate() wins, after every require.
--
-- ====================================================== end of the surface

local M = {}
local C

function M.init(ctx)
  assert(type(ctx) == 'table', 'rooms.init: a context table, read at call time')
  C = ctx
end

-- ------------------------------------------------------------- the rooms
--
-- STORAGE TIER: MEMORY, ON PURPOSE. Room candidates are presence, not
-- history -- Bob's laptop at the atrium-west AP for the next five minutes
-- -- and presence with a TTL is restart-tolerant by construction: every
-- member re-joins on an interval, so losing the table to a deploy costs
-- one refresh cycle of visibility and zero facts. What memory buys is the
-- spike: a conference's top-of-the-hour stampede becomes table writes in
-- the root program's own heap instead of a database transaction per hello.
-- What it PROMISES is better: these addresses never touch disk. Two
-- invariants keep that promise true -- this deployment must never enable
-- hibernation for the root instance (a snapshot would persist what we
-- said never lands), and nothing below ever writes a candidate through
-- the sql connector. This table IS the storage seam: a 'durable' room
-- tier later is a second implementation behind these three functions,
-- chosen per fetchpoint by a retention config field, not a rewrite.
--
-- Shape: ROOMS[fp_id][room][addr..'#'..port] = {address, port, name, at}.
-- Pruning is lazy (on touch) plus capacity-checked on join; the global
-- cap is a memory backstop far above any honest use.

local ROOMS = {}
local ROOMS_MAX_PER_FP = 256       -- distinct rooms one fetchpoint may hold
local ROOMS_GLOBAL_MAX = 100000    -- candidates across everything; backstop
local rooms_count = 0

local function room_prune(fp_id, room, ttl, t)
  local rs = ROOMS[fp_id] and ROOMS[fp_id][room]
  if not rs then return end
  for k, c in pairs(rs) do
    if c.at <= t - ttl then rs[k] = nil; rooms_count = rooms_count - 1 end
  end
  if next(rs) == nil then ROOMS[fp_id][room] = nil end
  if ROOMS[fp_id] and next(ROOMS[fp_id]) == nil then ROOMS[fp_id] = nil end
end

local function room_list(fp_id, room, ttl, t)
  room_prune(fp_id, room, ttl, t)
  local out = {}
  local rs = ROOMS[fp_id] and ROOMS[fp_id][room]
  if rs then for _, c in pairs(rs) do out[#out + 1] = c end end
  table.sort(out, function(a, b) return a.at > b.at end)
  return out
end

-- Returns the list after the join, or nil plus a refusal.
local function room_join(fp_id, room, ttl, capacity, cand, t)
  room_prune(fp_id, room, ttl, t)
  ROOMS[fp_id] = ROOMS[fp_id] or {}
  local fpr = ROOMS[fp_id]
  if not fpr[room] then
    local nrooms = 0
    for _ in pairs(fpr) do nrooms = nrooms + 1 end
    if nrooms >= ROOMS_MAX_PER_FP then
      return nil, 'room_limit', 'this fetchpoint holds its maximum number of rooms'
    end
    fpr[room] = {}
  end
  local rs = fpr[room]
  -- A peer-shaped entry (doc/ICE.md 3) is keyed by its ufrag: unique per
  -- session by construction, and what the other side needs anyway. A
  -- plain candidate keeps address#port, so a re-join refreshes it.
  local key = cand.ufrag and ('u#' .. cand.ufrag)
           or (cand.address .. '#' .. tostring(cand.port or 0))
  if not rs[key] then
    local n = 0
    for _ in pairs(rs) do n = n + 1 end
    if n >= capacity then
      return nil, 'room_full', 'this room holds its capacity of ' .. capacity
    end
    if rooms_count >= ROOMS_GLOBAL_MAX then
      return nil, 'rooms_saturated', 'the rendezvous store is at its global cap'
    end
    rooms_count = rooms_count + 1
  end
  rs[key] = cand
  return room_list(fp_id, room, ttl, t)
end

-- observed_address lives up in the helpers now -- the waitlist limiter
-- keys on it, and a local defined below a function that calls it would
-- never be captured.

-- Answers about the present moment must not be cached, and the read views
-- carry CORS because a browser on someone else's page is half the
-- audience: a JS snippet asking "what do I look like" or "where is the
-- home box" is exactly the product.
local PUBLIC_READ = { ['cache-control'] = 'no-store',
                      ['access-control-allow-origin'] = '*' }
local NO_STORE = { ['cache-control'] = 'no-store' }

-- Who may join or read a room, per the owner's config. 'open' is the
-- secret-meeting-id pattern when paired with an unguessable room name;
-- 'pin' is a human-typeable secret; 'key' is the owner's own credential.
-- Who may through a room's door, read from the ACCESS dimension rather than
-- from cfg.room_auth. The two say the same three things and the dimension
-- says it on the row, so a name's admission is visible in the same place as
-- the rest of what it is:
--
--   anyone  <- room_auth 'open'   no credential
--   token   <- room_auth 'key'    the fetchpoint's advertise key
--   code    <- room_auth 'pin'    a short shared code
--
-- cfg is still read, for two reasons and neither is transitional sloppiness:
-- rows written before the dimensions carry only room_auth (DIM.of maps them,
-- but an old row with no `access` at all falls through here), and the
-- credential VALUES -- advertise_key, room_pin -- are config, not dimensions.
--
-- The credential is taken from a header first and the query second. SS5.2
-- moves it to the header permanently, and the query spelling stays for the
-- window because wg_rendezvous.dlua is in the field sending ?pin= and ?key=
-- today (SS5.4).
-- room_auth WINS over the access dimension wherever it is set, and the order
-- matters more than it looks. DIM.of maps every legacy system:rendezvous row
-- to access='anyone' -- which is true of the NAME, anyone may read it -- and
-- reading that as the room's door opens every pin-protected room on the
-- deployment. api/run.sh caught it as "a wrong pin answered 200". The name's
-- access and the room's door are two different questions and only the second
-- one is room_auth.
local function room_allowed(d, cfg, req)
  local access
  if cfg.room_auth ~= nil then
    local mode = cfg.room_auth
    access = (mode == 'open' and 'anyone') or (mode == 'pin' and 'code') or 'token'
  elseif d and d.access and not d.derived then
    -- A row that STATED its access. Only then is the dimension the door.
    access = d.access
  else
    -- Nothing stated it. 'token' -- the advertise key -- is the old
    -- `cfg.room_auth or 'key'` default and it is the safe end: a room that
    -- nobody configured should be shut, not open. Reading a DERIVED access
    -- here is what silently opened every key-gated legacy room, which is
    -- the second time this function has been the place that happened.
    access = 'token'
  end
  if access == 'anyone' then return true end
  if access == 'code' then
    -- ?pin= only. x-df-pin is what §5.2 wants and it is NOT reachable:
    -- supervisor builds `req` from named header fields and never sets
    -- `req.headers`, so reading one here is a mechanism that looks present
    -- and does nothing. It lands when the listener allowlists the name and
    -- supervisor carries it.
    return cfg.room_pin ~= nil and req.query.pin == cfg.room_pin
  end
  local key = req.authorization and req.authorization:match('^[Bb]earer%s+(.+)$')
    or req.query.key
  return cfg.advertise_key ~= nil and key == cfg.advertise_key
end

-- What an endpoint may be, and the vocabulary is ICE's collapsed to three:
-- srflx and prflx are both "somebody outside told me", which is one fact
-- about reachability however it was learned. `source` carries the other
-- half -- observed by us, or asserted by the peer -- and the pair is what
-- makes a host endpoint claiming `observed` a refusal rather than a row.
local ENDPOINT_KINDS = { host = true, reflexive = true, relay = true }

-- ── claiming a room (§2.2, §5.3) ───────────────────────────────────────
--
-- A room is DURABLE where its membership is not, and this is the whole of
-- what the database learns: that the room exists and what its rules are.
--
-- CANONICALISE AT THE DOOR. Lowercase on the way in, and check uniqueness
-- against the canonical form, or K7F2 and k7f2 are two rooms -- which is a
-- support ticket from someone who typed their code correctly into a phone
-- keyboard that capitalised it.
local function canon_code(s)
  if type(s) ~= 'string' then return nil end
  return (s:lower())
end

-- 4 symbols over 32 is ~1.05M values, which IS guessable, and the room's own
-- lifetime is the mitigation (§5.3). That is the Zoom meeting-id trade and it
-- is a legitimate product; what we owe is informed consent at the moment of
-- choosing, which is the panel's job, not this function's.
local SHORTCODE_SYMBOLS = 4
local CLAIM_ATTEMPTS = 8

-- A uuid the guest can build: crypto/random answers in hex, and v4 is four
-- fixed bits plus two, so the string is assembled rather than drawn whole.
local function uuid4(hex)
  local h = hex:lower()
  local function seg(i, n) return h:sub(i, i + n - 1) end
  -- The variant nibble: the two high bits of byte 9 are forced to 10, which
  -- is what makes this a v4 string rather than 32 random hex digits wearing
  -- hyphens. The version nibble is the literal '4' below.
  local variant = string.format('%02x', (tonumber(seg(17, 2), 16) & 0x3f) | 0x80)
  return seg(1, 8) .. '-' .. seg(9, 4) .. '-4' .. seg(14, 3)
      .. '-' .. variant .. seg(19, 2) .. '-' .. seg(21, 12)
end

-- Draw, insert, let the database refuse a duplicate. Never SELECT then
-- INSERT -- it races with itself, and the UNIQUE index is the only atomicity
-- available without transactions. The same loop claim_label runs, for the
-- same reason: at these widths the retry is theatre against collision and
-- real against two requests drawing in the same instant.
-- The sql connector REFUSES a bare Lua nil as a bound parameter, and the
-- refusal is the right call: `nil` in a vararg list is indistinguishable
-- from an argument somebody forgot, so a typo would write NULL into a column
-- and look deliberate. An intentional NULL is spelled.
--
-- Worth a helper rather than a sentinel at each call site: a seat is mostly
-- nullable -- an EMPTY one has no peer, no role, no key -- and that is the
-- common case, not the edge.
local function nul(v) if v == nil then return C.host.sql.NULL end return v end

-- §4.1: the topic is the DNS label part, unique per fetchpoint. Same
-- expiry rule as a shortcode -- an expired row reads as absent, so a reaper
-- running behind shrinks the live name space and never mis-resolves.
local function room_by_topic(fp_id, topic, t)
  if type(topic) ~= 'string' or topic == '' then return nil end
  local q = C.db.query([[SELECT id, shortcode, topic, access, capacity, entry_ttl,
                                room_lifetime, visibility, expires_at
                           FROM room
                          WHERE fetchpoint_id = ? AND topic = ? LIMIT 1]],
    fp_id, topic)
  local r = C.rows_by_name(q)[1]
  if not r then return nil end
  if r.expires_at and r.expires_at <= t then return nil end
  return r
end

local function room_claim(fp_id, policy, t)
  local b32 = 'abcdefghijklmnopqrstuvwxyz234567'
  for _ = 1, CLAIM_ATTEMPTS do
    local hex = C.host.crypto.random(16)
    local id = uuid4(hex)
    local code = {}
    local rnd = C.host.crypto.random(SHORTCODE_SYMBOLS)
    for i = 1, SHORTCODE_SYMBOLS do
      local byte = tonumber(rnd:sub(i * 2 - 1, i * 2), 16) or 0
      code[i] = b32:sub((byte % 32) + 1, (byte % 32) + 1)
    end
    code = table.concat(code)
    local expires = policy.room_lifetime and (t + policy.room_lifetime) or nil
    local res = C.db.try_exec([[INSERT INTO room
        (id, fetchpoint_id, shortcode, topic, access, capacity, entry_ttl,
         room_lifetime, visibility, created_at, expires_at)
        VALUES (?,?,?,?,?,?,?,?,?,?,?)]],
      id, fp_id, code, nul(policy.topic), policy.access, policy.capacity,
      policy.entry_ttl, policy.room_lifetime, policy.visibility, t, expires)
    if res then
      return { id = id, shortcode = code, topic = policy.topic,
               access = policy.access,
               capacity = policy.capacity, entry_ttl = policy.entry_ttl,
               room_lifetime = policy.room_lifetime,
               visibility = policy.visibility, expires_at = expires }
    end
    -- A taken TOPIC is not a code collision and retrying cannot help: the
    -- shortcode is redrawn each pass, the topic is the caller's. Told apart
    -- so the caller learns which of the two names they cannot have.
    if policy.topic and room_by_topic(fp_id, policy.topic, t) then
      return nil, 'topic_taken',
             'this fetchpoint already has a room called ' .. policy.topic
    end
  end
  return nil, 'room_code_exhausted',
         'could not claim a free room code in ' .. CLAIM_ATTEMPTS .. ' attempts'
end

-- Resolve a code to its room. Canonical form only, and an expired row reads
-- as absent: a reaper running behind shrinks the live code space temporarily
-- and never mis-resolves, which is what makes a lazy sweep correct here
-- rather than merely cheap.
local function room_by_code(fp_id, code, t)
  local c = canon_code(code)
  if not c then return nil end
  local q = C.db.query([[SELECT id, shortcode, access, capacity, entry_ttl,
                                room_lifetime, visibility, expires_at
                           FROM room
                          WHERE fetchpoint_id = ? AND shortcode = ? LIMIT 1]], fp_id, c)
  local r = C.rows_by_name(q)[1]
  if not r then return nil end
  if r.expires_at and r.expires_at <= t then return nil end
  return r
end

-- ── seats and services (ROOMS-SPEC §4.2, §5.1) ─────────────────────────
-- Rows, unlike membership. ROOMS above is presence: a Lua table keyed by
-- address#port, pruned at entry_ttl, gone on restart. A SEAT is a position
-- that outlives whoever is sitting in it and can exist with nobody in it at
-- all, which is the whole of §4.2 -- an empty seat is how you pre-provision,
-- and §13's phone-by-QR reads a pubkey off one before the phone has spoken.
--
-- The two live side by side on purpose. Presence answers "who is here now",
-- which a row cannot without a write per heartbeat; a seat answers "whose
-- place is this", which memory cannot across a restart.

-- §4.2: ordinal is POSITION, sparse, 2^24 apart so an insertion between two
-- seats is a new number rather than a rewrite of every row after it. Never
-- an address -- §4.4 says the WireGuard subnet is not linked to it, and
-- calling it an address is the mistake the spacing exists to make obvious.
local ORDINAL_STEP = 16777216   -- 2^24


local function seat_create(room_id, f, t)
  local q = C.db.query('SELECT MAX(ordinal) FROM seat WHERE room_id = ?', room_id)
  local top = (q.rows and q.rows[1] and q.rows[1][1]) or 0
  local ordinal = top + ORDINAL_STEP
  local res = C.db.try_exec([[INSERT INTO seat
      (room_id, peer_id, ordinal, pinned, role, pubkey, requested_ips, at)
      VALUES (?,?,?,?,?,?,?,?)]],
    room_id, nul(f.peer_id), ordinal, f.pinned and 1 or 0, nul(f.role),
    nul(f.pubkey), nul(f.requested_ips), t)
  if not res then return nil end
  return { id = res.rowid, room_id = room_id, peer_id = f.peer_id,
           ordinal = ordinal, pinned = f.pinned and 1 or 0, role = f.role,
           pubkey = f.pubkey, requested_ips = f.requested_ips, at = t }
end

-- Pinned first, then ordinal: §5.2 says that is `match`'s default, and a
-- list that ordered differently from the selector would be a second answer
-- to the same question.
local function seat_list(room_id)
  return C.rows_by_name(C.db.query(
    [[SELECT id, peer_id, ordinal, pinned, role, pubkey, requested_ips, at
        FROM seat WHERE room_id = ? ORDER BY pinned DESC, ordinal LIMIT 256]],
    room_id))
end

local function service_create(room_id, f, t)
  local res = C.db.try_exec([[INSERT INTO service
      (room_id, peer_id, endpoint_id, verb, call, transport, effect, lifespan,
       expires_at, connect_hook, match_hook, pubkey, service_cidr, peer_ip,
       forwarding, txt, at)
      VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)]],
    room_id, nul(f.peer_id), nul(f.endpoint_id), f.verb, nul(f.call),
    nul(f.transport), nul(f.effect), f.lifespan or 'pinned', nul(f.expires_at),
    nul(f.connect_hook), nul(f.match_hook), nul(f.pubkey), nul(f.service_cidr),
    nul(f.peer_ip), f.forwarding and 1 or 0, nul(f.txt), t)
  if not res then return nil end
  return { id = res.rowid, room_id = room_id, peer_id = f.peer_id,
           verb = f.verb, call = f.call, transport = f.transport,
           effect = f.effect, lifespan = f.lifespan or 'pinned',
           pubkey = f.pubkey, service_cidr = f.service_cidr,
           peer_ip = f.peer_ip, forwarding = f.forwarding and 1 or 0,
           txt = f.txt, at = t }
end

local function service_list(room_id)
  return C.rows_by_name(C.db.query(
    [[SELECT id, peer_id, endpoint_id, verb, call, transport, effect,
             lifespan, expires_at, pubkey, service_cidr, peer_ip, forwarding,
             txt, at
        FROM service WHERE room_id = ? ORDER BY id LIMIT 256]], room_id))
end

local function valid_room(name)
  return type(name) == 'string' and #name >= 1 and #name <= 64
     and name:match('^[%w%-_]+$') ~= nil
end

function M.rooms_count_get() return rooms_count end
M.ROOMS              = ROOMS
M.ROOMS_GLOBAL_MAX   = ROOMS_GLOBAL_MAX
M.room_prune         = room_prune
M.room_list          = room_list
M.room_join          = room_join
M.PUBLIC_READ        = PUBLIC_READ
M.NO_STORE           = NO_STORE
M.room_allowed       = room_allowed
M.valid_room         = valid_room
M.ENDPOINT_KINDS     = ENDPOINT_KINDS
M.room_claim         = room_claim
M.room_by_code       = room_by_code
M.room_by_topic      = room_by_topic
M.canon_code         = canon_code
M.ORDINAL_STEP       = ORDINAL_STEP
M.seat_create        = seat_create
M.seat_list          = seat_list
M.service_create     = service_create
M.service_list       = service_list

return M
