-- ── the surface ────────────────────────────────────────────────────────
-- SOURCE   the program text, verbatim
-- DIGEST   sha256 of that text, so a caller can say which program it served
local M = {}

M.DIGEST = '47ff9111e0f09275'

M.SOURCE = [==[
-- deploy/gate1/relay/wg_rendezvous.dlua — the rendezvous a WireGuard peer needs,
-- as the root program of a `drt start` deployment that carries a
-- `wireguard` block (diluvium-drt, claude/wireguard-gotatun and later).
--
-- What DRT does: brings the interface up, measures this device's own NAT
-- mapping on listen_port and reports it (`wireguard_mapping`), adds peers
-- on command, and reports every handshake. What DRT deliberately does not
-- do (doc/WireGuard.md §4) is the exchange -- "a program's business" --
-- and this is that program, over a discofetch rendezvous room:
--
--   1. wait for `wireguard_mapping`. punchable:false means the relay is
--      the path: with a turn_server set, take an allocation and publish
--      the relayed address instead; without one, say so and stop.
--   2. join the room with the mapped port, our public key and our tunnel
--      address; read the room until another name is in it.
--   3. push one `add` command: their key, their tunnel address /32, their
--      endpoint, keepalive 25. WireGuard's own handshake retransmission
--      is the punch (§2 step 4); the keepalive holds it.
--   4. watch for the handshake and report the outcome to the room. Then
--      keep watching: a link that stops re-handshaking is a link whose
--      mapping moved (a laptop that changed networks, a peer that went
--      away), so ask the device to measure again (`remap`, rc5) and go
--      back to step 1 with whatever it says now.
--
-- Settings arrive on the `args` queue, which `drt start` fills from the
-- config's own `args` block -- so one file is the whole deployment and this
-- file carries the shape and never a key. rendezvous.json is the fallback
-- and the reason is FETCHPOINT-DESIGN §5.4: wg.sh writes that file and is
-- fetched from the site at install time, so a program that only read args
-- would break the next person to run the installer we are still serving.
-- Both work for the window; the file goes when wg.sh stops writing it.
-- ── entry points ────────────────────────────────────────────────────────
-- This is a root program: `drt start --config wg.json` runs it once,
-- forever. Nothing here is called from elsewhere.
-- ── configurable values ────────────────────────────────────────────────
local SETTINGS = 'rendezvous.json'   -- the fallback file: {fetchpoint, zone, room, name, key|pin, public_key, address, timeout_s, turn_server?, turn_realm?, stale_s?}
local ARGS_QUEUE = 'args'            -- fixed by the runtime; a config's `args` block lands here
local ARGS_WAIT_MS = 3000            -- args are pushed as soon as the queue exists, so this only ever elapses when there are none
local POLL_EVERY_MS = 2000           -- the room is re-read on this cadence while waiting
local KEEPALIVE = 25                 -- seconds; under any NAT's UDP timeout
local HANDSHAKE_WAIT_MS = 90000      -- WireGuard retransmits initiations for 90 s
local STALE_AFTER_MS = 300000        -- a live link re-handshakes every ~2 min; 5 min without one is a dead one
local TURN_TTL_S = 6 * 3600          -- the allocation dies with the credential (WireGuard.md), so mint long
local TURN_REALM = 'drt'             -- drt turn's default realm; rendezvous.json may say otherwise

-- ── depth: settings, and the room's URLs ───────────────────────────────
-- The queue is declared before the wait because that is what makes the
-- delivery happen: `drt start` retries the push every pass and succeeds the
-- moment the name exists. A config with no `args` block never pushes, so
-- the wait below is the full timeout exactly once, on the legacy path.
local S, FROM
do
  local args_q = queue.declare(ARGS_QUEUE, { capacity = 1 })
  local _, delivered = queue.wait({ args_q }, ARGS_WAIT_MS)
  if delivered then
    S, FROM = delivered, 'the config args'
  else
    -- pcall, not a bare call: a config built by the API grants no fs at all,
    -- and on that path this line is reached only if the args never came --
    -- which is a config bug worth naming, not a capability error worth
    -- crashing on with the connector's own wording.
    local okf, raw = pcall(host.fs.read, SETTINGS)
    if not okf or not raw or raw == '' then
      error('no settings: the config carried no `args` block, and ' .. SETTINGS
        .. ' could not be read (' .. tostring(okf and 'empty' or raw) .. ')')
    end
    S, FROM = json.decode(raw), SETTINGS
  end
end
for _, k in ipairs({ 'fetchpoint', 'zone', 'room', 'name', 'public_key', 'address' }) do
  if not S[k] or S[k] == '' then error(FROM .. ' needs ' .. k) end
end
if not (S.key or S.pin) then error(FROM .. ' needs key (the advertise key) or pin') end
if S.stale_s then STALE_AFTER_MS = S.stale_s * 1000 end
-- A live link re-handshakes about every 120 s and not sooner, so a
-- threshold under that calls every healthy link stale and remaps it on
-- a loop (the rig's first version did exactly that). The floor is the
-- rekey interval with room for one late one.
if STALE_AFTER_MS < 150000 then
  print('rendezvous: stale_s ' .. (STALE_AFTER_MS / 1000) .. ' is under WireGuard\'s rekey interval; using 150')
  STALE_AFTER_MS = 150000
end
if S.turn_realm then TURN_REALM = S.turn_realm end
local base = 'https://' .. S.fetchpoint .. '.' .. S.zone
local join_base = 'https://' .. S.fetchpoint .. '--join.' .. S.zone
local outcome_base = 'https://' .. S.fetchpoint .. '--outcome.' .. S.zone
-- The two-NAT rig (nat-rig.sh) has no DNS and no TLS: a stand-in
-- room at one http origin, the verbs told apart by path. Production
-- never sets this.
if S.api_base then
  base, join_base, outcome_base = S.api_base .. '/read', S.api_base .. '/join', S.api_base .. '/outcome'
end
local headers = S.key and { authorization = 'Bearer ' .. S.key } or {}
local door = S.pin and ('&pin=' .. S.pin) or ''

local function url_encode(s)
  return (tostring(s):gsub('[^%w%-_%.~]', function(c) return string.format('%%%02X', c:byte()) end))
end

local function get(url)
  local r, st, detail = host.try('rest/get', { url = url, headers = headers, timeout_ms = 8000 })
  if st ~= 'ok' then return nil, 'rest/get: ' .. tostring(detail) end
  if r.status ~= 200 then return nil, 'the room answered ' .. tostring(r.status) .. ': ' .. tostring(r.body) end
  local ok, obj = pcall(json.decode, r.body)
  if not ok then return nil, 'the room did not answer JSON' end
  return obj
end

-- The newest candidate that is not us and carries what a WireGuard peer
-- needs: a port (or a relayed endpoint), a public key, a tunnel address.
local function other_peer(cands)
  local best
  for _, c in ipairs(cands or {}) do
    if c.name ~= S.name and (c.port or c.relay) and c.wg_pubkey and c.wg_address then
      -- Two peers holding the same tunnel address cannot both be routed
      -- to: `add` would claim their address as ours, and the link would
      -- come up and carry nothing. Tunnel addresses are derived from the
      -- public key (wg.sh), so this is the ~1-in-65,000 collision, and
      -- it is worth a sentence rather than an afternoon.
      if c.wg_address == S.address then
        print('rendezvous: ' .. tostring(c.name) .. ' holds ' .. tostring(c.wg_address)
          .. ', which is our own tunnel address -- refusing. Give one side a '
          .. 'different address (rendezvous.json "address", and the matching '
          .. '"address" in the wireguard block).')
      elseif not best or (c.at or 0) > (best.at or 0) then
        best = c
      end
    end
  end
  return best
end

-- ── the queues: events from the wireguard bridge, commands back to it ──
-- `queue` (wg_in) is where the bridge pushes wireguard_mapping, wireguard
-- and wireguard_error; `reply_queue` (wg_out) is read by the bridge and
-- must be exported, like a listener's reply queue.
local events = queue.declare('wg_in', { capacity = 64 })
local commands = queue.declare('wg_out', { capacity = 8, exported = true })

local function say_error(m)
  print('wireguard_error: ' .. tostring(m.command) .. ': ' .. tostring(m.reason))
end

-- ── step 1: where are we, and is publishing it worth anything ──────────
local function wait_mapping()
  while true do
    local _, m = queue.wait({ events })
    if m.event == 'wireguard_mapping' then return m
    elseif m.event == 'wireguard_error' then say_error(m) end
  end
end

-- Not punchable means the measured address is one nobody can reach. With
-- `turn_fallback = true` on the block and a TURN server in the settings,
-- the device can send through an allocation instead: the program mints
-- the credential (crypto/turn_credential, attributed to this name), the
-- device answers with the RELAYED address, and that is what gets
-- published. The far side never learns the difference. Without a server
-- there is nothing to fall back to, and saying so is the whole output.
-- Returns the endpoint to publish and whether it is relayed; nil when
-- there is nothing worth publishing.
--
-- The allocation outlives a remap (it lives on the transport, not on the
-- pair a suspend drops), and a remap while relayed measures the DIRECT
-- path -- that is how a device learns the relay is no longer needed. So
-- `relayed_at` is the address the device is already relaying through:
-- punchable again means clear it and say so out loud (`clear = true`);
-- still not punchable means keep it rather than pay for a second one.
local function our_endpoint_of(mapping, relayed_at)
  if mapping.punchable then
    if relayed_at then
      print('rendezvous: punchable again (' .. tostring(mapping.address) .. '); giving the relay up')
      queue.push(commands, { command = 'relay', clear = true })
      while true do
        local _, m = queue.wait({ events })
        if m.event == 'wireguard_relay' and not m.address then break
        elseif m.event == 'wireguard_error' then say_error(m); break end
      end
    end
    return tostring(mapping.address), false
  end
  if relayed_at then
    print('rendezvous: still not punchable (' .. tostring(mapping.why) .. '); keeping the relay at ' .. relayed_at)
    return relayed_at, true
  end
  if not S.turn_server then
    print('rendezvous: this NAT is not punchable (' .. tostring(mapping.why) .. ') and no turn_server is set; the tunnel relay is the path.')
    return nil
  end
  print('rendezvous: not punchable (' .. tostring(mapping.why) .. '); relaying through ' .. S.turn_server)
  local cred = host.crypto.turn_credential(S.name, TURN_TTL_S)
  queue.push(commands, { command = 'relay', server = S.turn_server, realm = TURN_REALM,
                         username = cred.username, password = cred.password })
  while true do
    local _, m = queue.wait({ events })
    if m.event == 'wireguard_relay' and m.address then
      print('rendezvous: relayed address ' .. tostring(m.address))
      return tostring(m.address), true
    elseif m.event == 'wireguard_error' then error('relay refused: ' .. tostring(m.command) .. ': ' .. tostring(m.reason)) end
  end
end

-- ── step 2: join, then read until the other side is there ──────────────
-- A relayed endpoint is on the TURN server, not where the room observes
-- us from, so it travels as `relay` and the reader prefers it.
local function join(our_endpoint, relayed)
  local our_port = our_endpoint:match(':(%d+)$')
  local join_url = join_base .. '/?room=' .. url_encode(S.room) .. '&port=' .. our_port
    .. '&name=' .. url_encode(S.name) .. '&wg_pubkey=' .. url_encode(S.public_key)
    .. '&wg_address=' .. url_encode(S.address)
    .. (relayed and ('&relay=' .. url_encode(our_endpoint)) or '') .. door
  local joined, jerr = get(join_url)
  if not joined then error('join failed: ' .. jerr) end
  print('rendezvous: joined room ' .. S.room .. ' as ' .. S.name .. ', publishing ' .. our_endpoint)
  return joined
end

local function find_peer(joined)
  local peer = other_peer(joined.candidates)
  local waited = 0
  while not peer do
    -- A timed wait, because a device with no peers sends no snapshots
    -- before rc5: the timeout is the tick, and an event that arrives
    -- sooner is handled and does not delay the next read.
    local _, m = queue.wait({ events }, POLL_EVERY_MS)
    if m and m.event == 'wireguard_error' then say_error(m) end
    waited = waited + POLL_EVERY_MS
    local r, rerr = get(base .. '/?room=' .. url_encode(S.room) .. door)
    if r then peer = other_peer(r.candidates) elseif rerr then print('rendezvous: ' .. rerr) end
    if not peer and S.timeout_s and waited > S.timeout_s * 1000 then
      print('rendezvous: nobody else joined ' .. S.room .. ' within ' .. S.timeout_s .. 's')
      return nil
    end
  end
  return peer
end

-- ── step 3: one command; WireGuard's retransmission is the punch ───────
-- `add` on a peer the device already knows re-announces it (rc5), which
-- is exactly what a second pass after a remap wants.
local function announce(peer)
  local their_endpoint = peer.relay or (tostring(peer.address) .. ':' .. tostring(peer.port))
  print('rendezvous: peer ' .. tostring(peer.name) .. ' at ' .. their_endpoint .. ', tunnel ' .. peer.wg_address)
  queue.push(commands, {
    command     = 'add',
    public_key  = peer.wg_pubkey,
    allowed_ips = { peer.wg_address .. '/32' },
    endpoint    = their_endpoint,
    keepalive   = KEEPALIVE,
  })
end

-- ── step 4: did it work, and does it keep working ──────────────────────
-- A handshake is the answer; its age is the health. Returns when the
-- link is stale: no handshake within HANDSHAKE_WAIT_MS of the add, or a
-- handshake older than STALE_AFTER_MS after one had landed.
local function watch(peer, relayed, our_port)
  local t0 = host.time()
  local reported = false
  -- WHEN the last handshake happened, on our clock, rather than how old
  -- the device last said it was. A snapshot carries an age, and an age is
  -- only a fact about the moment it was sent: a device may stop reporting
  -- one at all for a session it has given up on, and a check that reads
  -- only the field then goes quiet exactly when the link is deadest.
  -- Converting to a wall time once means the timeout branch can decide
  -- staleness with no snapshot in hand.
  local handshake_at
  local function stale()
    return handshake_at ~= nil and host.time() - handshake_at > STALE_AFTER_MS
  end
  while true do
    local _, m = queue.wait({ events }, POLL_EVERY_MS)
    if not m then
      if not reported and host.time() - t0 > HANDSHAKE_WAIT_MS then
        print('rendezvous: no handshake in ' .. (HANDSHAKE_WAIT_MS / 1000) .. 's -- the punch did not land; '
          .. 'their side may not be up, or a NAT between us is not what its mapping said')
        return 'no handshake'
      end
      if stale() then
        print('rendezvous: nothing from ' .. tostring(peer.name) .. ' for '
          .. math.floor((host.time() - handshake_at) / 1000) .. 's -- the link is stale')
        return 'stale'
      end
    elseif m.event == 'wireguard_error' then
      say_error(m)
    elseif m.event == 'wireguard' then
      for _, p in ipairs(m.peers or {}) do
        if p.public_key == peer.wg_pubkey then
          if p.last_handshake_ms then handshake_at = host.time() - p.last_handshake_ms end
          if p.last_handshake_ms and not reported then
            print('rendezvous: HANDSHAKE with ' .. tostring(peer.name) .. ' via ' .. tostring(p.endpoint)
              .. ' after ' .. tostring(host.time() - t0) .. ' ms -- '
              .. (relayed and 'through our TURN relay' or peer.relay and 'through their TURN relay' or 'direct, no relay in the path'))
            reported = true
            -- Reported, not observed: the room counts it apart from
            -- silence. Addressed by PORT, which is how this peer joined
            -- -- the address the room has for us is the one it observed,
            -- and it observes this request too. `ufrag` was sent here
            -- once, carrying the peer NAME, which is neither a ufrag nor
            -- the key a plain candidate is stored under: it could not
            -- have matched even on a fetchpoint serving ice.
            local _, oerr = get(outcome_base .. '/?room=' .. url_encode(S.room)
              .. '&port=' .. tostring(our_port)
              .. '&path=' .. ((relayed or peer.relay) and 'relay' or 'direct') .. door)
            if oerr then print('rendezvous: outcome not recorded: ' .. oerr) end
          elseif reported and stale() then
            print('rendezvous: last handshake with ' .. tostring(peer.name) .. ' was '
              .. math.floor((host.time() - handshake_at) / 1000) .. 's ago -- the link is stale')
            return 'stale'
          elseif not reported and host.time() - t0 > HANDSHAKE_WAIT_MS then
            print('rendezvous: no handshake in ' .. (HANDSHAKE_WAIT_MS / 1000) .. 's -- the punch did not land')
            return 'no handshake'
          end
        end
      end
    end
  end
end

-- ── the loop: measure, publish, meet, watch; on a stale link, again ────
-- The first pass takes the mapping the device measured before it bound
-- the port. Every later pass asks for a fresh one (`remap`): the device
-- suspends, measures, resumes, and re-emits wireguard_mapping -- a
-- rehandshake it would have needed anyway, since a stale link has dead
-- sessions already.
print('rendezvous: waiting for this device\'s mapping')
local pass = 0
local relayed_at = nil          -- the relayed address while the device relays; nil when direct
while true do
  pass = pass + 1
  if pass > 1 then
    print('rendezvous: measuring the mapping again (remap, pass ' .. pass .. ')')
    queue.push(commands, { command = 'remap' })
  end
  local mapping = wait_mapping()
  local our_endpoint, relayed = our_endpoint_of(mapping, relayed_at)
  if not our_endpoint then return end
  relayed_at = relayed and our_endpoint or nil
  local joined = join(our_endpoint, relayed)
  local peer = find_peer(joined)
  if not peer then return end
  announce(peer)
  local why = watch(peer, relayed, our_endpoint:match(':(%d+)$'))
  print('rendezvous: ' .. why .. '; the mapping may have moved -- starting over')
end
]==]

return M
