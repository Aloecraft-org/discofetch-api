-- discofetch API.
--
-- The URL shapes were settled first, by handlers that echoed what they were
-- given -- those were cheap to get wrong and expensive to change later, which
-- is the opposite of a handler body. Nothing echoes any more: every endpoint
-- is backed by a real row, a real counter, or a real refusal, and the last
-- echo (traffic) was replaced by the in-memory meter it was standing in for.
--
-- Shape of the thing: the listener turns a socket request into a message on
-- `http_in` and a message on `http_out` back into a response, with `conn`
-- echoed verbatim so replies can be answered out of order. The root program
-- IS the server -- there is no framework under this, and the loop below is
-- the whole request lifecycle.

local http_in  = queue.declare('http_in',  { capacity = 32 })
local http_out = queue.declare('http_out', { capacity = 32, exported = true })

local API_VERSION = 'v1'

-- ------------------------------------------------------------- the database
--
-- The deployment grants a scope (a directory); naming the database is the
-- program's job. `create = false` over there means a missing file is refused
-- rather than conjured, which is the behaviour we want: a database has to be
-- created out of band so WAL is set before the first open, and the authorizer
-- denies PRAGMA to guests permanently, so the program could never fix it
-- afterwards.
--
-- `host.sql.open` is client-side sugar -- the name rides along in each call
-- as args.db -- so it does not itself touch the disk. The refusal arrives on
-- the first exec instead, which is why both live inside one pcall below and
-- why the recorded error is the connector's own sentence.

local DB_NAME = 'discofetch.sqlite'

local db                       -- the handle, or nil if opening failed
local db_ready = false
local db_error = nil

-- host:time answers in MILLISECONDS; the schema is unix seconds throughout.
-- Every write divides, and this is the only place that knows it.
local function now() return host.time() // 1000 end

-- The context modules read. Its fields are read at CALL time, not when a
-- module loads: `db` is not open yet here, and a module cannot see a
-- main-chunk upvalue anyway. One table rather than a dep per module, so a
-- module gains a dependency without every require line changing.
local CTX = { now = now, json = json, host = host, db_ready = false,
              push = queue.push, http_out = http_out }
-- rows_by_name is published below, where it is declared.

-- Migrations, carried in the release as the twelfth factor wants -- guests
-- have no `require` and no `dofile`, and the .sql files are not readable from
-- inside the sandbox without granting `fs` for one consumer.
--
-- Statements are stored PRE-SPLIT rather than as one blob split at runtime.
-- The connector prepares exactly one statement per call, so something has to
-- do the splitting; doing it at runtime means stripping `--` comments and
-- then splitting on `;`, which works until the first migration containing a
-- semicolon or a double dash inside a string literal, and then cuts a
-- statement in half silently. A Lua array has no such day.
--
-- api/migrations/*.sql stays the readable source of this table.
local MIGRATIONS = {
  {
    version = 1,
    statements = {
      [[CREATE TABLE IF NOT EXISTS account (
          id            INTEGER PRIMARY KEY,
          auth0_sub     TEXT    NOT NULL UNIQUE,
          email         TEXT,
          tier          TEXT    NOT NULL DEFAULT 'free',
          role          TEXT    NOT NULL DEFAULT 'user',
          created_at    INTEGER NOT NULL,
          last_seen_at  INTEGER,
          suspended_at  INTEGER
        ) STRICT]],
      [[CREATE INDEX IF NOT EXISTS account_by_email ON account(email)]],
    },
  },
  {
    version = 2,
    statements = {
      -- The allocator. A label outlives its FetchPoint: it is claimed, and
      -- the row is never deleted, so the PRIMARY KEY alone guarantees a name
      -- is never handed to a second owner. That is what the quarantine window
      -- in doc/DATA-MODEL.md exists to provide, obtained for free by not
      -- deleting rows -- a resolver still holding the old answer can never
      -- reach a new owner because there is never a new owner.
      [[CREATE TABLE IF NOT EXISTS label (
          label             TEXT    PRIMARY KEY,
          fetchpoint_id     INTEGER,
          allocated_at      INTEGER NOT NULL,
          released_at       INTEGER,
          published_at      INTEGER,
          published_target  TEXT
        ) STRICT]],
      [[CREATE TABLE IF NOT EXISTS fetchpoint (
          id                INTEGER PRIMARY KEY,
          owner_account_id  INTEGER NOT NULL REFERENCES account(id),
          label             TEXT    NOT NULL UNIQUE REFERENCES label(label),
          name              TEXT    NOT NULL,
          kind              TEXT    NOT NULL,
          config            TEXT    NOT NULL DEFAULT '{}',
          host              TEXT    NOT NULL DEFAULT 'fetch1',
          created_at        INTEGER NOT NULL,
          updated_at        INTEGER NOT NULL,
          deleted_at        INTEGER
        ) STRICT]],
      -- Partial, so it indexes live rows only: the dashboard's query is
      -- always "mine, not deleted", and the index is then the size of the
      -- answer rather than of the history.
      [[CREATE INDEX IF NOT EXISTS fetchpoint_live_by_owner
          ON fetchpoint(owner_account_id) WHERE deleted_at IS NULL]],
    },
  },
  {
    version = 3,
    statements = {
      -- The token itself is NEVER stored. `hash` is sha256 of the secret and
      -- is the lookup key, so a copy of this database lets nobody
      -- authenticate as anybody: the column holds the answer to a question
      -- only the holder of the token can ask.
      --
      -- Plain sha256 rather than a slow KDF ON PURPOSE. A password needs
      -- bcrypt because a human chose it; this secret is 160 bits from
      -- crypto/random, so there is no dictionary to run and stretching would
      -- only tax the request path. And sha256 rather than crypto.hmac, which
      -- is keyed under the host secret: hmac would mean losing the key file
      -- invalidates every token in circulation, and the key file is already
      -- load-bearing for label generation.
      --
      -- `prefix` is stored separately so the panel can show which token a row
      -- refers to without holding anything usable.
      [[CREATE TABLE IF NOT EXISTS api_token (
          id             INTEGER PRIMARY KEY,
          account_id     INTEGER NOT NULL REFERENCES account(id),
          fetchpoint_id  INTEGER REFERENCES fetchpoint(id),
          name           TEXT    NOT NULL DEFAULT '',
          prefix         TEXT    NOT NULL,
          hash           TEXT    NOT NULL UNIQUE,
          scopes         TEXT    NOT NULL DEFAULT '[]',
          created_at     INTEGER NOT NULL,
          last_used_at   INTEGER,
          expires_at     INTEGER,
          revoked_at     INTEGER
        ) STRICT]],
      [[CREATE INDEX IF NOT EXISTS api_token_by_account ON api_token(account_id)]],
    },
  },
  {
    version = 4,
    statements = {
      -- The waitlist. Registration is closed, so the front page takes an
      -- email instead. The UNIQUE is the dedupe -- there are no transactions,
      -- so INSERT OR IGNORE against it is the whole concurrency story.
      --
      -- Emails leave this table two ways, and both are the operator: the
      -- sqlite3 shell, and GET /v1/admin/waitlist, which demands a verified
      -- session whose account row says role = 'admin' -- a column only the
      -- holder of the database can set, so the reader and the shell are the
      -- same trust boundary. A PUBLIC read here would be a breach of the one
      -- promise a waitlist makes, and there still is none.
      [[CREATE TABLE IF NOT EXISTS waitlist (
          id          INTEGER PRIMARY KEY,
          email       TEXT    NOT NULL UNIQUE,
          created_at  INTEGER NOT NULL,
          source      TEXT
        ) STRICT]],
    },
  },
  {
    version = 5,
    statements = {
      -- Runtime state, its own table rather than columns on fetchpoint:
      -- config is owner intent and arrives by PATCH; this row is written
      -- by the rendezvous dns verb OBSERVING a caller, and is what the
      -- DNS publisher (and one day the nameserver) reads. Different write
      -- paths, different tables -- and a new table needs no ALTER, which
      -- matters because migrations 1-4 are frozen once run and SQLite
      -- has no idempotent ADD COLUMN.
      [[CREATE TABLE IF NOT EXISTS advertisement (
          fetchpoint_id  INTEGER PRIMARY KEY REFERENCES fetchpoint(id),
          address        TEXT    NOT NULL,
          at             INTEGER NOT NULL
        ) STRICT]],
    },
  },
  {
    version = 6,
    statements = {
      -- The event log: what was DONE, as against what was served. Two
      -- account columns rather than one, because "who" splits in two the
      -- moment staff can act on a customer's behalf. `account_id` is the
      -- SUBJECT -- whose timeline the row belongs to, and who is entitled
      -- to read it. `actor_id` is WHO DID IT. They are equal for every
      -- action a person takes on their own account, and the day they
      -- differ is exactly the day an impersonated change would otherwise
      -- be invisible to the person it happened to. That day is the whole
      -- reason both columns exist now rather than after impersonation
      -- lands, because a column added later cannot describe the rows
      -- written before it.
      --
      -- CONTROL PLANE ONLY: creates, deletes, mints, revokes, settings --
      -- decisions someone made. Never reads, room joins or DNS
      -- advertisements. Those are the in-memory meter's job (TRAFFIC) and
      -- must stay there: a durable row per dns update, across every name,
      -- on a 30s cadence, is millions of rows a week written to a sqlite
      -- file that does not yet have backups.
      --
      -- `detail` is JSON on purpose. A new fact about an event then costs
      -- a key rather than a migration, which matters more here than
      -- anywhere else in the schema: this table has no ALTER available to
      -- it (SQLite has no idempotent ADD COLUMN, and migrate() re-runs a
      -- migration that stopped half way), so every column it will ever
      -- have is in this statement.
      [[CREATE TABLE IF NOT EXISTS event (
          id             INTEGER PRIMARY KEY,
          at             INTEGER NOT NULL,
          account_id     INTEGER REFERENCES account(id),
          actor_id       INTEGER REFERENCES account(id),
          actor_role     TEXT    NOT NULL DEFAULT 'user',
          kind           TEXT    NOT NULL,
          fetchpoint_id  INTEGER REFERENCES fetchpoint(id),
          label          TEXT,
          detail         TEXT    NOT NULL DEFAULT '{}',
          address        TEXT
        ) STRICT]],
      [[CREATE INDEX IF NOT EXISTS event_by_account ON event(account_id, at DESC)]],
      [[CREATE INDEX IF NOT EXISTS event_recent ON event(at DESC)]],
    },
  },
  {
    version = 7,
    statements = {
      -- The prelaunch mechanism, and BOTH tables land together on purpose.
      -- Only `account_grant` has a reader in this slice; `invite` has none
      -- yet. They share a version anyway because a version that has run on
      -- a deployment can never be edited afterwards, so splitting them would cost
      -- the invite slice a migration 8 for a table whose text is already
      -- settled -- and the two are one design (an invite CONFERS grants;
      -- redeeming one writes rows in the other).
      [[CREATE TABLE IF NOT EXISTS invite (
          code         TEXT    PRIMARY KEY,
          created_by   INTEGER REFERENCES account(id),
          created_at   INTEGER NOT NULL,
          expires_at   INTEGER,
          max_uses     INTEGER NOT NULL DEFAULT 1,
          used_count   INTEGER NOT NULL DEFAULT 0,
          revoked_at   INTEGER,
          note         TEXT    NOT NULL DEFAULT '',
          confers      TEXT    NOT NULL DEFAULT '[]'
        ) STRICT]],
      -- GET /v1/invites: "the codes I minted", newest first. The PRIMARY KEY
      -- already serves the other access pattern -- POST /v1/redeem looking a
      -- code up whole -- so this is the only index the table needs.
      [[CREATE INDEX IF NOT EXISTS invite_by_creator
          ON invite(created_by, created_at DESC)]],
      -- `account_grant`, not `grant`: SQLite would take the bare word, and a
      -- reader who has used any other database would flinch at it.
      --
      -- One table for a tester's thank-you, a referral bonus and a paid pack,
      -- because they differ only in `source`. Three tables each doing a third
      -- of the job drift within a month, and the day billing lands it would
      -- be the third of them that learns about expiry.
      [[CREATE TABLE IF NOT EXISTS account_grant (
          id           INTEGER PRIMARY KEY,
          account_id   INTEGER NOT NULL REFERENCES account(id),
          kind         TEXT    NOT NULL,
          quantity     INTEGER NOT NULL DEFAULT 0,
          detail       TEXT    NOT NULL DEFAULT '{}',
          source       TEXT    NOT NULL DEFAULT '',
          offered_at   INTEGER NOT NULL,
          redeemed_at  INTEGER,
          expires_at   INTEGER,
          revoked_at   INTEGER,
          spent        INTEGER NOT NULL DEFAULT 0
        ) STRICT]],
      -- GET /v1/me's grants list and the account detail page: every grant on
      -- one account, newest first. id DESC rather than offered_at DESC for
      -- the reason both timelines page on id -- two grants offered in the
      -- same second are ordinary and `offered_at` cannot order them.
      [[CREATE INDEX IF NOT EXISTS account_grant_by_account
          ON account_grant(account_id, id DESC)]],
      -- quota_of's aggregate, which runs on the CREATE PATH: the sum of an
      -- account's live bonuses, on every fetchpoint and every token minted.
      -- Partial on the two clauses that are columns, so the index holds live
      -- grants only -- most rows here will be redeemed and unrevoked, but an
      -- offered-and-never-accepted one is exactly what it must not scan. The
      -- expiry clause stays in the query because it compares against now().
      [[CREATE INDEX IF NOT EXISTS account_grant_live
          ON account_grant(account_id, kind)
          WHERE redeemed_at IS NOT NULL AND revoked_at IS NULL]],
    },
  },
  {
    version = 8,
    statements = {
      -- The email OUTBOX, and only the outbox: what should be sent, to
      -- whom, from which template, with which values. The API never sends
      -- mail -- guests have no SMTP and host:rest stays ungranted -- so a
      -- puller beside the mail server claims rows over HTTPS and hands
      -- them to the relay, exactly the arrangement the nameserver's zone
      -- puller proved. The two networks never open a door to each other:
      -- both machines only ever dial OUT to the public API.
      --
      -- `template` is a KEY into brand/emails/ (the puller holds the
      -- files); the body text never enters this table, so rewording an
      -- email touches no row and leaks nothing here. `params` is the
      -- placeholder values as JSON -- which for an invite email includes
      -- the invite URL, making a row exactly as sensitive as the mail it
      -- describes. That is why reading this table is the ADMIN bar with
      -- no audit view: a masked outbox row is useless to the puller and
      -- an unmasked one hands addresses to a role that exists to be
      -- shown less.
      [[CREATE TABLE IF NOT EXISTS email_outbox (
          id           INTEGER PRIMARY KEY,
          to_addr      TEXT    NOT NULL,
          template     TEXT    NOT NULL,
          params       TEXT    NOT NULL DEFAULT '{}',
          state        TEXT    NOT NULL DEFAULT 'queued',
          attempts     INTEGER NOT NULL DEFAULT 0,
          created_by   INTEGER REFERENCES account(id),
          created_at   INTEGER NOT NULL,
          claimed_at   INTEGER,
          sent_at      INTEGER,
          last_error   TEXT    NOT NULL DEFAULT ''
        ) STRICT]],
      -- The puller's scan is `state = 'queued' ORDER BY id` (oldest mail
      -- first); the panel's is newest-anything first, which the PRIMARY
      -- KEY serves.
      [[CREATE INDEX IF NOT EXISTS email_outbox_by_state
          ON email_outbox(state, id)]],
    },
  },  {
    version = 9,
    statements = {
      -- The four dimensions, promoted out of `config` and out of `kind`
      -- (doc/FETCHPOINT-DESIGN.md §1). Columns rather than JSON for two
      -- reasons: STRICT type checking, and because admin_resolve currently
      -- decodes `config` in Lua to filter on serve == 'dns', which is why its
      -- pagination counts rows SCANNED rather than returned. As a column that
      -- filter is an ordinary WHERE.
      --
      -- Every column is NULLABLE and nothing is backfilled here. A row written
      -- before this migration keeps its `kind`, and the read path derives its
      -- dimensions from it (fp_dimensions, marked transitional). That is
      -- deliberate: a backfill is a one-time script whose correctness nobody
      -- can check afterwards, and it would have to run before we know from
      -- fetch1 which kinds are actually out there. The derive converges as
      -- rows are rewritten, and it is deleted with the kinds.
      --
      -- SOFT, because ADD COLUMN has no IF NOT EXISTS -- see the runner.
      { soft = [[ALTER TABLE fetchpoint ADD COLUMN template TEXT]] },
      { soft = [[ALTER TABLE fetchpoint ADD COLUMN source TEXT]] },
      { soft = [[ALTER TABLE fetchpoint ADD COLUMN access TEXT]] },
      { soft = [[ALTER TABLE fetchpoint ADD COLUMN channel TEXT]] },
      { soft = [[ALTER TABLE fetchpoint ADD COLUMN behavior TEXT]] },
      { soft = [[ALTER TABLE fetchpoint ADD COLUMN subject TEXT]] },
      { soft = [[ALTER TABLE fetchpoint ADD COLUMN published_address TEXT]] },
      { soft = [[ALTER TABLE fetchpoint ADD COLUMN published_locked INTEGER]] },
      { soft = [[ALTER TABLE fetchpoint ADD COLUMN redirect_target TEXT]] },
      { soft = [[ALTER TABLE fetchpoint ADD COLUMN redirect_status INTEGER]] },
      { soft = [[ALTER TABLE fetchpoint ADD COLUMN report_format TEXT]] },
      { soft = [[ALTER TABLE fetchpoint ADD COLUMN serve_relay_config INTEGER]] },
      -- The hard half. Naming every column in one SELECT makes a soft ALTER
      -- that failed for the WRONG reason -- a missing table rather than an
      -- existing column -- raise here instead of being carried silently into
      -- a deployment where the first symptom is a create that cannot write.
      [[SELECT template, source, access, channel, behavior, subject,
               published_address, published_locked, redirect_target,
               redirect_status, report_format, serve_relay_config
          FROM fetchpoint LIMIT 0]],
      -- The resolver's filter is a column now, so it gets the index the JSON
      -- version could never have.
      [[CREATE INDEX IF NOT EXISTS fetchpoint_by_channel
          ON fetchpoint(channel) WHERE deleted_at IS NULL]],
    },
  },

  -- 010 · a room is an object with its own policy. Readable source:
  -- migrations/010_room.sql, which carries the reasoning.
  --
  -- The line this migration either holds or erodes (doc/FETCHPOINT-DESIGN.md
  -- §2.4): the database knows THAT A ROOM EXISTS AND WHAT ITS RULES ARE, AND
  -- NOTHING ABOUT WHO IS IN IT. Nothing below has a peer column and nothing
  -- below may grow one -- membership and endpoints stay in the heap, which
  -- is the promise, not an optimisation.
  {
    version = 10,
    statements = {
      -- Keyed by uuid with shortcode SEPARATE and unique per fetchpoint
      -- (§2.2): a room outlives its code, a collision is a retry rather
      -- than an error, and a code is reusable once the room is reaped.
      -- shortcode is nullable because a room nobody types their way into
      -- has none, and SQLite treats NULLs as distinct in a UNIQUE index.
      [[CREATE TABLE IF NOT EXISTS room (
          id             TEXT    PRIMARY KEY,
          fetchpoint_id  INTEGER NOT NULL,
          shortcode      TEXT,
          access         TEXT,
          capacity       INTEGER,
          entry_ttl      INTEGER,
          room_lifetime  INTEGER,
          visibility     TEXT,
          created_at     INTEGER NOT NULL,
          expires_at     INTEGER
        ) STRICT]],
      -- The claim's atomicity, and the only check-and-claim the connector
      -- allows: INSERT and catch the UNIQUE violation, never SELECT then
      -- INSERT.
      [[CREATE UNIQUE INDEX IF NOT EXISTS room_code
          ON room (fetchpoint_id, shortcode)]],
      [[CREATE INDEX IF NOT EXISTS room_expiry ON room (expires_at)]],
      -- Two clocks (§2.3), on the fetchpoint, as the defaults its rooms
      -- inherit. One number cannot serve both: an arcade's empty table must
      -- persist and a party code must not. SOFT -- see the runner.
      { soft = [[ALTER TABLE fetchpoint ADD COLUMN entry_ttl INTEGER]] },
      { soft = [[ALTER TABLE fetchpoint ADD COLUMN room_lifetime INTEGER]] },
      -- The hard half: a soft ALTER that failed because the TABLE was
      -- missing is skipped as silently as one that failed because the
      -- column was already there, and this is what tells the two apart.
      [[SELECT entry_ttl, room_lifetime FROM fetchpoint LIMIT 0]],
    },
  },
  {
    -- ── migration 011: the Rooms spec's object model ────────────────────
    -- doc/ROOMS-SPEC.md Appendix A. Draft 4 was pasted into conversation for
    -- days and committed on 15 Sep; doc/ROOMS-GAP.md counted what was
    -- missing (11 of 15 tables) and this closes it.
    --
    -- IT IS A SIMPLIFICATION, not a growth. `kind` + config_fields +
    -- validate_config -- 283 lines that dispatch on a category -- are
    -- replaced by SERVICE's five columns, which describe what a thing DOES
    -- rather than what it is called. Endpoints stop being a parallel notion
    -- and become what a service fronts; observations stop being endpoint
    -- rows with provenance glued on.
    --
    -- WHAT MUST SURVIVE, and it is a short list: api_token (one account's,
    -- and the ns_puller / mail_puller tokens ride on it) and the reflect
    -- canary's fetchpoint. Observations are ephemeral by definition, no
    -- invite is outstanding, and no peer or seat exists to migrate because
    -- room membership has only ever been a Lua table in process memory.
    -- So this migration ADDS and never rewrites: nothing here drops a
    -- column, and every existing row keeps answering.
    version = 11,
    statements = {
      -- ── the room becomes the spec's room (§4.1, §4.3) ────────────────
      -- `topic` is the change that matters: §4.1 says a room has a topic,
      -- not a name -- the DNS label part, unique per fetchpoint. Without it
      -- every <fetchpoint>--<topic>--<verb> name in §9 is unreachable and a
      -- room is addressable only by shortcode.
      --
      -- `access` STAYS beside `join_policy` because they are different
      -- axes: access is the door's credential (anyone/code/token) and
      -- join_policy is approval (open/request). §4.3 wants both, and
      -- wg_rendezvous.dlua on machines we do not own reads the first.
      [[ALTER TABLE room ADD COLUMN topic TEXT]],
      [[ALTER TABLE room ADD COLUMN join_policy TEXT NOT NULL DEFAULT 'open']],
      [[ALTER TABLE room ADD COLUMN ordering TEXT NOT NULL DEFAULT 'fifo']],
      [[ALTER TABLE room ADD COLUMN locked INTEGER NOT NULL DEFAULT 0]],
      [[ALTER TABLE room ADD COLUMN disclose_liveness TEXT NOT NULL DEFAULT 'shared']],
      [[ALTER TABLE room ADD COLUMN disclose_capability TEXT NOT NULL DEFAULT 'shared']],
      [[ALTER TABLE room ADD COLUMN ip_policy TEXT NOT NULL DEFAULT 'ignore']],
      [[ALTER TABLE room ADD COLUMN permissions TEXT]],
      [[ALTER TABLE room ADD COLUMN udp_port INTEGER]],
      -- Unique per fetchpoint, like shortcode. NULLs are distinct in SQLite,
      -- so rooms without a topic do not collide with each other.
      [[CREATE UNIQUE INDEX IF NOT EXISTS room_topic ON room(fetchpoint_id, topic)]],

      -- §1.1 and §3: the two fetchpoint-level columns the spec names.
      [[ALTER TABLE fetchpoint ADD COLUMN display_names INTEGER NOT NULL DEFAULT 0]],
      [[ALTER TABLE fetchpoint ADD COLUMN peer_capacity INTEGER]],

      -- ── peer (§3) ────────────────────────────────────────────────────
      -- A device known to a FETCHPOINT, not to a room -- identity is per
      -- fetchpoint and a peer may sit in several rooms. `name` is ASSERTED:
      -- identity cannot be observed, and the column says so because the
      -- distinction is the whole of §3's first paragraph.
      --
      -- durability follows WHY the peer exists, not how long it has been
      -- around: a device someone added is durable, one that appeared by
      -- joining is ephemeral and expires. Peer capacity counts the durable.
      [[CREATE TABLE IF NOT EXISTS peer (
          id             INTEGER PRIMARY KEY,
          fetchpoint_id  INTEGER NOT NULL,
          account_id     INTEGER,
          name           TEXT,
          ufrag          TEXT,
          pwd            TEXT,
          durability     TEXT    NOT NULL DEFAULT 'ephemeral',
          expires_at     INTEGER,
          at             INTEGER NOT NULL
        ) STRICT]],
      [[CREATE INDEX IF NOT EXISTS peer_by_fp ON peer(fetchpoint_id)]],
      [[CREATE INDEX IF NOT EXISTS peer_by_account ON peer(account_id)]],

      -- ── seat (§4.2) ──────────────────────────────────────────────────
      -- A POSITION in a room, occupied by a peer or empty. An empty seat is
      -- how you pre-provision -- §13's phone-by-QR reads `pubkey` and
      -- `requested_ips` off one before the phone has ever spoken.
      --
      -- `ordinal` is position and never an address: sparse, spaced by 2^24
      -- so an insertion between two seats needs no rewrite, rescaled when
      -- the gaps run out. Calling it an address is the mistake §4.2 exists
      -- to prevent, and 4.4 says the WireGuard subnet is not linked to it.
      [[CREATE TABLE IF NOT EXISTS seat (
          id             INTEGER PRIMARY KEY,
          room_id        TEXT    NOT NULL,
          peer_id        INTEGER,
          ordinal        INTEGER NOT NULL,
          pinned         INTEGER NOT NULL DEFAULT 0,
          role           TEXT,
          pubkey         TEXT,
          requested_ips  TEXT,
          at             INTEGER NOT NULL
        ) STRICT]],
      [[CREATE INDEX IF NOT EXISTS seat_by_room ON seat(room_id, ordinal)]],
      [[CREATE INDEX IF NOT EXISTS seat_by_peer ON seat(peer_id)]],

      -- ── service (§5) ─────────────────────────────────────────────────
      -- The table that replaces `kind`. Five columns say what a thing does
      -- -- verb, call, transport, effect, lifespan -- and there is NO type
      -- column by decision (§5.1): grouping is `effect`, and any finer
      -- family is a txt key such as family=ssh.
      --
      -- peer_id NULL is a service the ROOM pins rather than a peer
      -- advertises. lifespan='parked' is residency and, per §2.2, a node:
      -- the row is the record of it, and the node is the socket.
      [[CREATE TABLE IF NOT EXISTS service (
          id             INTEGER PRIMARY KEY,
          room_id        TEXT    NOT NULL,
          peer_id        INTEGER,
          endpoint_id    INTEGER,
          verb           TEXT    NOT NULL,
          call           TEXT,
          transport      TEXT,
          effect         TEXT,
          lifespan       TEXT    NOT NULL DEFAULT 'pinned',
          expires_at     INTEGER,
          connect_hook   TEXT,
          match_hook     TEXT,
          pubkey         TEXT,
          service_cidr   TEXT,
          peer_ip        TEXT,
          forwarding     INTEGER NOT NULL DEFAULT 0,
          txt            TEXT,
          at             INTEGER NOT NULL
        ) STRICT]],
      [[CREATE INDEX IF NOT EXISTS service_by_room ON service(room_id, verb)]],
      [[CREATE INDEX IF NOT EXISTS service_by_peer ON service(peer_id)]],

      -- ── endpoint (§2.1, §5) ──────────────────────────────────────────
      -- An address. Fetchpoint-level, and ALWAYS reached behind a service:
      -- that rule is what stops an endpoint being a second way to address a
      -- thing, which is what the old model had.
      [[CREATE TABLE IF NOT EXISTS endpoint (
          id             INTEGER PRIMARY KEY,
          fetchpoint_id  INTEGER NOT NULL,
          kind           TEXT    NOT NULL,
          value          TEXT    NOT NULL,
          port           INTEGER
        ) STRICT]],
      [[CREATE INDEX IF NOT EXISTS endpoint_by_fp ON endpoint(fetchpoint_id)]],

      -- ── observation (§3 liveness) ────────────────────────────────────
      -- What a room has SEEN about an endpoint, service or peer. This is
      -- where provenance lives -- `source` observed or asserted -- so the
      -- thing observed does not have to carry it.
      --
      -- Ephemeral by definition, which is why nothing migrates into it: the
      -- endpoint typing added by c166c77 lives in a Lua table today and is
      -- lost on every restart. `last_seen` is liveness and §3 says render
      -- it with age, never as a bare boolean.
      [[CREATE TABLE IF NOT EXISTS observation (
          id             INTEGER PRIMARY KEY,
          room_id        TEXT    NOT NULL,
          of_kind        TEXT    NOT NULL,
          of_id          INTEGER NOT NULL,
          kind           TEXT    NOT NULL,
          source         TEXT    NOT NULL,
          integrity      INTEGER NOT NULL DEFAULT 0,
          reported       TEXT,
          rtt_ms         INTEGER,
          first_seen     INTEGER NOT NULL,
          last_seen      INTEGER NOT NULL
        ) STRICT]],
      [[CREATE UNIQUE INDEX IF NOT EXISTS observation_one
          ON observation(room_id, of_kind, of_id, kind, source)]],

      -- ── template, grant, redemption (§6.3) ───────────────────────────
      -- The reusable definition, the issued instance, and who took it.
      -- Nothing migrates: no invite is outstanding. The existing `invite`
      -- table stays untouched and keeps answering -- it merges what this
      -- splits, and retiring it is a later decision made on evidence.
      --
      -- A grant may carry real authorization (token_id) or be nothing more
      -- than a link, like a Discord invite. Both are tracked the same way,
      -- which is what makes one mechanism cover a meet invite, a join
      -- request and an account invite.
      [[CREATE TABLE IF NOT EXISTS template (
          id             INTEGER PRIMARY KEY,
          fetchpoint_id  INTEGER NOT NULL,
          kind           TEXT    NOT NULL,
          for_kind       TEXT,
          for_id         INTEGER,
          text           TEXT,
          card_html      TEXT,
          default_ttl    INTEGER,
          max_uses       INTEGER,
          at             INTEGER NOT NULL
        ) STRICT]],
      [[CREATE INDEX IF NOT EXISTS template_by_fp ON template(fetchpoint_id)]],
      [[CREATE TABLE IF NOT EXISTS grant (
          id             INTEGER PRIMARY KEY,
          template_id    INTEGER NOT NULL,
          code           TEXT    NOT NULL UNIQUE,
          recipient      TEXT,
          token_id       INTEGER,
          payload        TEXT,
          expires_at     INTEGER,
          revoked_at     INTEGER,
          at             INTEGER NOT NULL
        ) STRICT]],
      [[CREATE TABLE IF NOT EXISTS redemption (
          id             INTEGER PRIMARY KEY,
          grant_id       INTEGER NOT NULL,
          by_kind        TEXT    NOT NULL,
          by_id          INTEGER NOT NULL,
          result_kind    TEXT,
          result_id      INTEGER,
          at             INTEGER NOT NULL
        ) STRICT]],
      [[CREATE INDEX IF NOT EXISTS redemption_by_grant ON redemption(grant_id)]],

      -- ── token (§6.2) ─────────────────────────────────────────────────
      -- NOT api_token, and api_token is NOT TOUCHED. That table holds one
      -- account's live credentials -- ns_puller and mail_puller among them
      -- -- and breaking it breaks the fleet. This is the spec's polymorphic
      -- token: issuer x scope, which api_token's account/fetchpoint pair
      -- cannot express. The two coexist until something needs them not to.
      [[CREATE TABLE IF NOT EXISTS room_token (
          id             INTEGER PRIMARY KEY,
          issuer_kind    TEXT    NOT NULL,
          issuer_id      INTEGER NOT NULL,
          scope_kind     TEXT    NOT NULL,
          scope_id       INTEGER NOT NULL,
          prefix         TEXT,
          hash           TEXT    NOT NULL UNIQUE,
          single_use     INTEGER NOT NULL DEFAULT 0,
          expires_at     INTEGER,
          revoked_at     INTEGER,
          at             INTEGER NOT NULL
        ) STRICT]],
      [[CREATE INDEX IF NOT EXISTS room_token_by_scope
          ON room_token(scope_kind, scope_id)]],

      -- ── keypair (§6.1) ───────────────────────────────────────────────
      -- Any entity may hold one. `private` is NULL when the key is derived
      -- (room keys are HKDF(fetchpoint_secret, room_id), memory-only and
      -- stable across hibernation) or held only in a node -- so a NULL here
      -- is a statement, not a missing value.
      --
      -- Generated on fetchpoint create from the start. That is nearly free
      -- now and is the difference between a trust root existing when
      -- something needs it and a migration later. df/keys.dlua is the
      -- writer; migration 012 renames `pubkey` here to `kid`, which is what
      -- it turned out to hold.
      [[CREATE TABLE IF NOT EXISTS keypair (
          id             INTEGER PRIMARY KEY,
          entity_kind    TEXT    NOT NULL,
          entity_id      INTEGER NOT NULL,
          pubkey         TEXT    NOT NULL UNIQUE,
          private        TEXT,
          created_at     INTEGER NOT NULL,
          rotated_at     INTEGER
        ) STRICT]],
      [[CREATE UNIQUE INDEX IF NOT EXISTS keypair_one
          ON keypair(entity_kind, entity_id)]],

      -- ── sanction (§0), usage (§11) ───────────────────────────────────
      -- Both are tables the spec names and neither has a consumer yet.
      -- They are here because adding a table to a live database later is a
      -- migration and adding it now is a line, and because `usage` is what
      -- §11's metering writes to and that was already planned.
      [[CREATE TABLE IF NOT EXISTS sanction (
          id             INTEGER PRIMARY KEY,
          scope_kind     TEXT    NOT NULL,
          scope_id       INTEGER NOT NULL,
          restricts_kind TEXT    NOT NULL,
          restricts_id   INTEGER NOT NULL,
          kind           TEXT    NOT NULL,
          reason         TEXT,
          at             INTEGER NOT NULL,
          expires_at     INTEGER
        ) STRICT]],
      [[CREATE INDEX IF NOT EXISTS sanction_by_scope
          ON sanction(scope_kind, scope_id)]],
      [[CREATE TABLE IF NOT EXISTS usage (
          id             INTEGER PRIMARY KEY,
          fetchpoint_id  INTEGER NOT NULL,
          room_id        TEXT,
          meter          TEXT    NOT NULL,
          value          INTEGER NOT NULL DEFAULT 0,
          period_start   INTEGER NOT NULL
        ) STRICT]],
      -- COALESCE, not the bare column. SQLite treats NULLs as DISTINCT in a
      -- unique index, which is exactly what `room` wants for shortcode and
      -- topic -- two rooms without a code do not collide -- and exactly
      -- wrong here: a fetchpoint-level meter has room_id NULL, so the bare
      -- index lets the same (fetchpoint, meter, period) insert twice and
      -- the counter silently doubles. Measured: two inserts, two rows.
      [[CREATE UNIQUE INDEX IF NOT EXISTS usage_one
          ON usage(fetchpoint_id, COALESCE(room_id, ''), meter, period_start)]],
    },
  },
  {
    version = 12,
    statements = {
      -- ── keypair holds a NAME, not a public key (§6.1) ─────────────────
      -- 011 gave keypair a `pubkey TEXT NOT NULL UNIQUE`, on the assumption
      -- that an entity's key has a public half. Measured against drt
      -- 0.7.0-rc.1, it does not: the crypto connector offers `crypto/derive`,
      -- which registers a key under a LABEL inside the connector and returns
      -- nothing, and `crypto/jwt_sign` then takes `key = '<label>'` and puts
      -- that label in the token's `kid` header. HS256 -- symmetric. There is
      -- no public half to store, and a column named pubkey holding the
      -- label's name would be a lie in the schema.
      --
      -- So the column is renamed to what it holds. `kid` is not an
      -- abbreviation we invented: it is the JWT header field the host
      -- already writes, so a verifier reading a token and a reader of this
      -- table are looking at the same string.
      --
      -- Safe as a rename rather than a rebuild because the table has never
      -- had a writer -- 011 created it empty and shipped, and nothing has
      -- inserted a row on any deployment since.
      { soft = [[ALTER TABLE keypair RENAME COLUMN pubkey TO kid]] },
      -- And a real public key, for the day a host capability makes one.
      -- Nullable, because today every row is a derived symmetric key and
      -- NULL is the true answer rather than a missing one.
      { soft = [[ALTER TABLE keypair ADD COLUMN pubkey TEXT]] },
      -- The hard half, per the runner's rule: a soft ALTER that failed
      -- because the table was missing is skipped as silently as one that
      -- failed because it was already applied.
      [[SELECT kid, pubkey, private FROM keypair LIMIT 0]],
    },
  },

}

local function migrate()
  -- Bootstrap first: the runner cannot consult a table it has not created.
  db.exec([[CREATE TABLE IF NOT EXISTS schema_migration (
      version    INTEGER PRIMARY KEY,
      applied_at INTEGER NOT NULL
    ) STRICT]])

  local done = {}
  for _, r in ipairs(db.query('SELECT version FROM schema_migration').rows) do
    done[r[1]] = true
  end

  -- A statement is a string that MUST succeed, or { soft = '...' } that may
  -- fail. Soft exists for exactly one thing: `ALTER TABLE ... ADD COLUMN` has
  -- no IF NOT EXISTS form, and the version row is written only after every
  -- statement in a version succeeds -- so a version that stops half way
  -- re-runs its earlier statements, and a bare ALTER raises `duplicate column
  -- name` on the second pass. Measured against build11 and drt 0.5.0: ALTER is
  -- permitted by the authorizer, and it does raise on a re-run.
  --
  -- Soft swallows the error, which is the risk: an ALTER that failed because
  -- the TABLE was missing would be skipped as silently as one that failed
  -- because the column was already there. So every soft run is followed by a
  -- HARD statement that names the columns -- a `SELECT ... LIMIT 0` raises
  -- when a column is absent, which turns "silently skipped" into "loudly
  -- wrong" at the one moment somebody can still fix it.
  for _, m in ipairs(MIGRATIONS) do
    if not done[m.version] then
      for _, stmt in ipairs(m.statements) do
        if type(stmt) == 'table' then pcall(db.exec, stmt.soft) else db.exec(stmt) end
      end
      -- The version row goes in only after every statement succeeded. There
      -- are no transactions -- the authorizer denies BEGIN -- so a migration
      -- can stop half applied and there is nothing to roll back. Recording
      -- the version last is what makes a re-run converge instead of skipping
      -- the rest of a file it never finished.
      db.exec('INSERT INTO schema_migration (version, applied_at) VALUES (?, ?)',
              m.version, now())
    end
  end

end

-- Opening and migrating at startup, but NOT fatally. A crash loop here would
-- take /health down with it, and then the panel's indicator says "unreachable"
-- -- which is the one thing that is definitely not true. Serving with an
-- honest 503 keeps the reason visible to anyone who can curl.
do
  local ok, err = pcall(function()
    db = host.sql.open(DB_NAME)
    migrate()
  end)
  if ok then
    db_ready = true
    CTX.db, CTX.db_ready = db, true
  else
    db_error = tostring(err)
    CTX.db_error = db_error
  end
end

-- ------------------------------------------------------------ the label
--
-- 16 symbols of RFC 4648 base32, lowercased: 80 bits, and the subdomain a
-- FetchPoint lives at as well as its public id. doc/DATA-MODEL.md §3.1 has
-- the reasoning, including why this is random rather than derived from the
-- account and fetchpoint ids.

-- An IP literal, v4 strictly and v6 loosely: the nameserver will validate
-- for real; this check keeps prose and URLs out of address columns. Shared
-- by the paste endpoint and the address_override config field.
-- ------------------------------------------------------------ the label
--
-- What a label is, and the two checks either side of it, live in
-- df/label.dlua -- all of it pure, so that module takes no context.
-- claim_label stays here: it is the check-and-claim loop against the
-- database, which is a property of this deployment rather than of labels.
local LBL = require('df.label')
local valid_ip, base32_from_hex, valid_label, LABEL_BYTES =
      LBL.valid_ip, LBL.base32_from_hex, LBL.valid_label, LBL.LABEL_BYTES
local ZONE = 'discofetch.link'
-- The zone is deployment topology and the model needs it to split a
-- FetchPoint host; published here, where it is declared.
CTX.ZONE = ZONE

-- ICE (doc/ICE.md): what the --ice verb hands an RTCPeerConnection. STUN
-- is public and free; TURN is metered per name, which is why its URL
-- sits here and its credential is minted per request, attributed to the
-- label. The TURN name does not resolve yet -- it is the name the
-- deployment WILL use -- and turn=true is refused on an open room at
-- config time rather than at runtime by surprise.
--
-- One table, not seven locals: a Lua main chunk holds at most 200 locals
-- and this file was within a handful of the limit. The host refuses to
-- load past it -- "too many local variables (limit is 200)" -- which is a
-- deploy-time failure with a compile-time cause, so keep new constants
-- grouped.
local ICE = {
  -- The STUN pair, spelled once: RTCPeerConnection wants `stun:` URLs
  -- (STUN_URLS, below) and `drt netcheck --stun` wants host:port, and two
  -- lists of the same two servers is how they drift apart.
  STUN_HOSTS = { 'stun1.' .. ZONE .. ':3478', 'stun2.' .. ZONE .. ':3478' },
  -- The edges' ADDRESSES, as a caller must reach them to compare two
  -- vantages: gate1, gate2 (deploy/gates/ns/README.md, NETCHECK-SPEC.md §4).
  -- Names would not do -- reflect's name resolves to both, and two fetches
  -- of it can land on one edge twice. Answered in every JSON reflect
  -- (`measure`, diluvium-drt #25 §1) so `drt netcheck --reflect <url>` is
  -- the whole invocation: the edge says how to measure against it, and
  -- the operator stops being the transport for addresses that live in a
  -- document. When an edge moves, this moves with the zone file.
  VANTAGES = { '108.165.121.165', '172.237.132.87' },
  TURN_URLS = { 'turn:turn.' .. ZONE .. ':3478?transport=udp' },
  TURN_TTL = 3600,            -- seconds a minted TURN credential lives
  MAX_CANDIDATES = 12,        -- per peer, doc/ICE.md 3
  MAX_CANDIDATE_BYTES = 256,  -- each, encoded
  CAND_TYPES = { host = true, srflx = true, prflx = true, relay = true },
  PATHS = { direct = true, relay = true, failed = true },
}
ICE.STUN_URLS = { 'stun:' .. ICE.STUN_HOSTS[1], 'stun:' .. ICE.STUN_HOSTS[2] }
-- The ICE endpoints are deployment topology; the fetchpoint verbs need
-- them, so they are published here where they are declared.
CTX.ICE = ICE
local function claim_label(t)
  for _ = 1, 8 do
    local label = base32_from_hex(host.crypto.random(LABEL_BYTES))
    if valid_label(label) then
      local res = db.try_exec(
        'INSERT INTO label (label, allocated_at) VALUES (?, ?)', label, t)
      if res then return label end
    end
  end
  return nil, 'could not claim a label in 8 attempts'
end

-- ------------------------------------------------------------- bootstrap
--
-- reflect.discofetch.link is a real FetchPoint: an ordinary row owned by
-- the system account, created here idempotently, never special-cased in
-- dispatch. If the product cannot host its own reflect, the product is
-- wrong -- and once the zone points at the edge this row is the permanent
-- end-to-end canary: reflect answering means DNS, the edge, the hub, the
-- listener and the database all work. 'reflect' cannot collide with a
-- generated label (wrong length, and no random draw produces it) and no
-- IdP can mint the sub 'system|root', so nothing can log in as the owner.
-- That invariant is only as strong as the ways INTO an account, and act-as
-- is one that never asks an IdP: act_as_apply refuses any sub in the
-- 'system|' scope for exactly this reason, because a staff window here
-- reaches DELETE and the canary's label can never be re-issued. The two
-- ends have to move together.
if db_ready then
  local okb, berr = pcall(function()
    local t = now()
    db.exec([[INSERT OR IGNORE INTO account (auth0_sub, tier, created_at)
              VALUES ('system|root', 'system', ?)]], t)
    local sys = db.query(
      [[SELECT id FROM account WHERE auth0_sub = 'system|root']]).rows[1][1]
    local have = db.query([[SELECT count(*) FROM fetchpoint
        WHERE label = 'reflect' AND deleted_at IS NULL]]).rows[1][1]
    if have == 0 then
      -- try_exec: the label row may survive from an earlier boot whose
      -- fetchpoint insert failed; the PK refusal is then not an error.
      db.try_exec([[INSERT INTO label (label, allocated_at) VALUES ('reflect', ?)]], t)
      local ins = db.exec([[INSERT INTO fetchpoint
          (owner_account_id, label, name, kind, config, created_at, updated_at)
          VALUES (?1, 'reflect', 'reflect', 'system:reflect', '{}', ?2, ?2)]], sys, t)
      db.exec([[UPDATE label SET fetchpoint_id = ? WHERE label = 'reflect']], ins.rowid)
    end
  end)
  if not okb then print('bootstrap: ' .. tostring(berr)) end
end

-- ---------------------------------------------------------------- helpers
--
-- The wire -- request parsing, the one response envelope, and the edge's
-- observation of the caller -- lives in df/http.dlua.
local HTTP = require('df.http')
HTTP.init(CTX)
local split_query, reply, fail, AUTH_CHALLENGE =
      HTTP.split_query, HTTP.reply, HTTP.fail, HTTP.AUTH_CHALLENGE
local observed_address, observed_port, public_forwarded =
      HTTP.observed_address, HTTP.observed_port, HTTP.public_forwarded
-- ------------------------------------------------------------- the meter
--
-- Quotas, rate limits and traffic counters, together because they are one
-- subject: what a tier may hold, how fast a name may be exercised, and what
-- actually happened. It lives in df/meter.dlua now, with the reasoning for
-- the numbers beside them.
--
-- `buckets_shed` is reached through MT.shed_count() rather than bound here:
-- it MUTATES, so a copy taken at startup would report zero forever.
local MT = require('df.meter')
MT.init(CTX)
local TIERS, TRAFFIC, BUCKETS_MAX, BOOT_AT =
      MT.TIERS, MT.TRAFFIC, MT.BUCKETS_MAX, MT.BOOT_AT
local tier_of, rate_allow, rate_headers = MT.tier_of, MT.rate_allow, MT.rate_headers
local traffic_bump, traffic_totals = MT.traffic_bump, MT.traffic_totals

-- ----------------------------------------------------------------- routes
--
-- Ordered, and matched in order. `{label}` is a slug: letters, digits, dash
-- and underscore. Token ids are the same, so a bad one 404s at the route
-- rather than reaching a handler that has to invent a refusal.
--
-- Every pattern is anchored at both ends. Without the trailing anchor
-- `/v1/fetchpoints` would match `/v1/fetchpointsXYZ`, which is the kind of
-- thing that works in every test you write and none that you don't.

local SLUG = '([%w%-_]+)'
-- The one thing the API surface needs that belongs to this deployment
-- rather than to any domain: the check-and-claim loop behind a new label.
-- API_VERSION and SLUG are literals and live with the routes.
CTX.claim_label = claim_label

-- -------------------------------------------------------------- handlers
--
-- One function per endpoint: (req, params) -> status, payload. Nothing here
-- touches the queue, so a handler can be exercised without a socket. All of
-- them echo for now, on purpose (see the top of the file); creates answer
-- 201. Deletes answer 200 with the echo -- a real one returns 204 and no
-- body, which has nothing to echo, and the README says so.

-- Resolving the caller, once, for every handler that needs one. This is the
-- seam doc/ROADMAP.md's Phase 4 calls "one auth middleware": today it knows
-- only about x-df-sub, and when dfp_live_ tokens land they resolve to an
-- account here and nothing below this line learns there was a second way in.
-- ------------------------------------------------------------------ tokens
--
-- Who is asking -- tokens, sessions, and acting as somebody else -- lives in
-- df/identity.dlua, with the x-df-sub / act-as trust model stated beside the
-- code that depends on it.
local IDN = require('df.identity')
IDN.init(CTX)
local TOKEN_PREFIX, TOKEN_BYTES, opaque_token = IDN.TOKEN_PREFIX, IDN.TOKEN_BYTES, IDN.opaque_token
local require_session, require_own_account = IDN.require_session, IDN.require_own_account
local act_as_apply, resolve_account, waitlist_join =
      IDN.act_as_apply, IDN.resolve_account, IDN.waitlist_join
-- it and a Lua local is invisible above its own declaration.
local function rows_by_name(q)
  local out = {}
  for _, row in ipairs(q.rows) do
    local m = {}
    for i, name in ipairs(q.cols) do m[name] = row[i] end
    out[#out + 1] = m
  end
  return out
end
CTX.rows_by_name = rows_by_name

-- ------------------------------------------------------------- the grants
--
-- What an account was given, and the quota that falls out of it, live in
-- df/grants.dlua -- including quota_of's three combining rules and why a
-- typo there must degrade rather than outage.
local GRN = require('df.grants')
GRN.init(CTX)
local GRANT_KINDS, GRANT_QUANTITY_MAX, GRANT_COLS, grant_live_sql =
      GRN.GRANT_KINDS, GRN.GRANT_QUANTITY_MAX, GRN.GRANT_COLS, GRN.grant_live_sql
local validate_grant, grant_insert, grant_object, grant_by_id, grants_of, quota_of =
      GRN.validate_grant, GRN.grant_insert, GRN.grant_object, GRN.grant_by_id,
      GRN.grants_of, GRN.quota_of
-- me_body and me_get moved into df/api.dlua with the rest of the handlers;
-- ROUTES names me_get and ROUTES lives there.

-- The domain model -- the kind registry, the four dimensions, and what a
-- FetchPoint's config may say -- lives in df/model.dlua.
local MDL = require('df.model')
MDL.init(CTX)
local KINDS, validate_config, DIM, secret_fields, REDACTED =
      MDL.KINDS, MDL.validate_config, MDL.DIM, MDL.secret_fields, MDL.REDACTED
local config_view, same_config, fp_row, fp_row_status, fetchpoint_host =
      MDL.config_view, MDL.same_config, MDL.fp_row, MDL.fp_row_status, MDL.fetchpoint_host
-- --------------------------------------------------------- the event log
--
-- One writer for the whole program, so "is this action recorded" is a
-- question with one place to look rather than a grep. It lives in
-- df/event_log.dlua now; the properties it advertises -- never throws,
-- never fails a request, no secrets in `detail`, optional columns ABSENT
-- from the statement rather than bound as nil -- are documented there,
-- beside the code that holds them.
local EV = require('df.event_log')
EV.init(CTX)
local trim_events, log_event = EV.trim_events, EV.log_event

-- And once at startup, which is the case the counter above cannot cover.
-- `events_written` starts at zero every boot, so a service deployed more
-- often than it writes two hundred control-plane events never reaches the
-- opportunistic trim at all -- and "more often than two hundred control
-- plane actions" describes this deployment exactly, today and for a while
-- yet. A restart is also the one moment we know for certain nobody is
-- waiting on a request, so the delete's cost lands on no customer.
--
-- Its OWN pcall, deliberately not migrate()'s: a retention sweep that
-- throws must cost the sweep and never `db_ready`. Answering 503 on every
-- endpoint because a ninety-one-day-old row would not delete would be a
-- far worse outage than the table it was protecting us from.
if db_ready then
  local okt, terr = pcall(trim_events)
  if not okt then print('event trim: ' .. tostring(terr)) end
end

-- Acting as somebody else lives in df/identity.dlua, beside the thing it
-- modifies: act_as_apply is FORWARD-DECLARED up there and assigned after
-- the event log, and the two halves have to share a chunk or the assignment
-- writes a different variable than the call reads.
-- -------------------------------------------------------------- handlers
--
-- The /v1 surface -- every handler, the route table, and the two questions
-- the loop asks of it -- lives in df/api.dlua. ROUTES travels with the
-- handlers, which is what keeps this require two names rather than
-- thirty-four.
--
-- rooms and fetchpoint no longer have a require block of their own here --
-- their sections moved into df/api.dlua -- but supervisor still owns
-- init()ing every module, so the context is published in exactly one place.
-- df/keys is init()ed HERE and bound to nothing, for the reason the comment
-- above gives: supervisor owns init()ing every module so the context is
-- published in one place, and df/api.dlua is the only caller. require caches,
-- so the table api.dlua asks for is this one, already holding the context. A
-- module init()ed nowhere reads a nil context at its first call -- which
-- would surface as a crash inside a create, not here.
require('df.keys').init(CTX)

-- ROOMS-SPEC §6.1, for the names that already exist. The create path derives
-- a key for every fetchpoint made from now on; migration 012 cannot do the
-- same for the ones already in the table, because deriving is a hostcall and
-- a migration is SQL. So it happens here, once a boot, and finds nothing on
-- every boot after the first.
--
-- Bounded by construction: one hostcall and one insert per fetchpoint that
-- has no key, and after this run there are none. The LIMIT is the connector's
-- max_result_rows, not a page -- a deployment with more names than that gets
-- the rest on the next boot rather than a refused query, which is the right
-- trade for a backfill nothing is waiting on.
--
-- Its OWN pcall, for the reason trim_events has one: a fetchpoint without a
-- key is a fetchpoint that cannot sign yet. A deployment that answers 503 on
-- every endpoint because a key would not derive is a far worse outage than
-- the thing it was protecting.
local function backfill_keys()
  local KEYS = require('df.keys')
  local rows = rows_by_name(db.query(
    [[SELECT f.id AS id FROM fetchpoint f
       WHERE f.deleted_at IS NULL
         AND NOT EXISTS (SELECT 1 FROM keypair k
                          WHERE k.entity_kind = 'fetchpoint' AND k.entity_id = f.id)
       LIMIT 256]]))
  local made, t = 0, now()
  for _, r in ipairs(rows) do
    local kid = KEYS.ensure('fetchpoint', r.id)
    if kid then
      db.exec([[INSERT INTO keypair (entity_kind, entity_id, kid, created_at)
                VALUES ('fetchpoint', ?, ?, ?)]], r.id, kid, t)
      made = made + 1
    end
  end
  if #rows > 0 then
    print('keys: ' .. made .. ' of ' .. #rows .. ' fetchpoint keys derived')
  end
end
if db_ready then
  local okk, kerr = pcall(backfill_keys)
  if not okk then print('key backfill: ' .. tostring(kerr)) end
end
local ROO = require('df.rooms')
ROO.init(CTX)
local FP = require('df.fetchpoint')
FP.init(CTX)
-- The loop hands this to pcall BY REFERENCE, so it has to be a name here.
local serve_fetchpoint = FP.serve_fetchpoint
local API = require('df.api')
API.init(CTX)
local route, is_public = API.route, API.is_public
-- ------------------------------------------------------------------- loop

-- The loop lives in a function, not the main chunk, for a reason that is
-- not style: Lua caps a function at 200 active locals, the main chunk is
-- one function, and every `local` above counts against it -- so did the
-- loop's own block locals while they were in scope here. Wrapping the loop
-- moves its sixteen into their own function and leaves the chunk room for
-- the next table someone declares above. If the loader ever says `too many
-- local variables (limit is 200) in main function`, bundle top-level locals
-- into a namespace table (as DIM is) rather than moving them out of the
-- surface block.
local function serve_forever()
while true do
  local _, m, why = queue.wait({ http_in }, 30000)
  if why == 'ok' then
    local path, query = split_query(m.path or '/')
    local req = {
      method = m.method,
      path = path,
      query = query,
      -- The UNPARSED target, for the one consumer that must not lose the
      -- query string: a redirecting rendezvous forwards path and query
      -- verbatim, so label.discofetch.link/api?x=1 lands on /api?x=1.
      target = m.path,
      body = m.body,
      -- `headers` is always present when the deployment allowlists anything
      -- -- possibly empty, but present -- so the shape here is decided by
      -- api.config.json rather than by what a given request happened to carry.
      authorization = m.headers and m.headers.authorization or nil,
      sub = m.headers and m.headers['x-df-sub'] or nil,
      act_as = m.headers and m.headers['act-as'] or nil,
      -- Lowercased and stripped of any port, because a Host is not
      -- case-sensitive and "example.com" and "example.com:8080" address the
      -- same thing. Doing it here means no comparison below has to remember.
      host = (m.headers and m.headers.host or ''):lower():match('^([^:]*)') or '',
      -- The edge's observation (x-real-ip, one writer we own -- the edge
      -- SETS it) and the informational relay chain. See api.config.json.
      real_ip = m.headers and m.headers['x-real-ip'] or nil,
      forwarded = m.headers and m.headers['x-forwarded-for'] or nil,
      -- The NAT-observation pair (doc/REFLECT-NAT.md): the source port the
      -- edge terminated, and WHICH edge -- constant while there is one
      -- edge, load-bearing the day a second exists, because NAT mappings are
      -- per-destination and a caller on a two-IP name must know which
      -- vantage answered. Deliberately not x-df-*: that namespace is the
      -- stripped identity boundary, and these must survive the trip.
      real_port = m.headers and m.headers['x-real-port'] or nil,
      edge = m.headers and m.headers['x-edge'] or nil,
    }

    -- ---- FetchPoint traffic ------------------------------------------
    --
    -- The API and every FetchPoint share one listener on one port, so the
    -- Host header is what tells them apart. This branch comes FIRST and
    -- returns without touching the /v1 router, because a FetchPoint is not
    -- an API route: it has no account credential, it is reached by whoever
    -- the owner gave the address to, and running it through the gate below
    -- would demand a session from a device that will never have one.
    --
    -- Note what this means about trust. The Host is chosen by the caller and
    -- nothing upstream verifies it, so it SELECTS a FetchPoint and confers
    -- nothing. Every authority question inside a FetchPoint is answered by
    -- its own config and its own tokens, never by the name used to arrive.
    -- Three parts now (ROOMS-SPEC §9). fp_topic is nil for every host shape
    -- that existed before, so a deployed wg.sh calling <label>--join reaches
    -- exactly the handler it always did.
    local fp_label, fp_verb, fp_topic = fetchpoint_host(req.host)
    if fp_label then
      -- Under pcall for the same reason handlers are: a bug serving one
      -- FetchPoint answers 500 to that request, never takes the API down.
      local okp, perr = pcall(serve_fetchpoint, m.conn, req, fp_label, fp_verb, fp_topic)
      if not okp then
        print('fetchpoint error: ' .. tostring(req.host) .. ': ' .. tostring(perr))
        fail(m.conn, 500, 'internal_error', 'the request failed; the reason is in the log')
      end
    elseif path == '/health' then
      -- Liveness that does not lie. Answering 200 while the database is
      -- unopenable would put the panel's indicator on green over an API that
      -- cannot serve a single real endpoint; 503 turns it amber WITH the
      -- reason, which is the state the panel was built to show. The
      -- unauthenticated shape is deliberate -- /health answers "is anything
      -- there" and must keep working before auth exists.
      if db_ready then
        reply(m.conn, 200, { ok = true, service = 'discofetch-api',
                             api = API_VERSION, db = 'ready' })
      else
        reply(m.conn, 503, { ok = false, service = 'discofetch-api',
                             api = API_VERSION, db = 'unavailable',
                             error = db_error })
      end
    else
      -- A credential is either a verified session (x-df-sub, asserted by the
      -- gateway) or an opaque token in the Authorization header. The gate
      -- asks only whether one is PRESENT; whether it is any good is
      -- resolve_account's job, and the answers differ -- a token that does
      -- not resolve is 401 from there with its own sentence.
      local credentialed = req.sub ~= nil or opaque_token(req.authorization) ~= nil

      local handler, params, allowed = route(m.method, path)
      if handler and not credentialed and not is_public(m.method, path) then
        -- Refused BEFORE the handler runs. resolve_account still makes the
        -- same check for the handlers that call it, and that is not redundant
        -- -- it is what keeps a handler correct if it is ever called from
        -- somewhere other than here. This gate is what makes the ones that
        -- DON'T call it safe.
        fail(m.conn, 401, 'unauthenticated', 'no verified identity on this request',
             AUTH_CHALLENGE)
      elseif handler then
        -- Under pcall: a bug in one request answers 500 to that request,
        -- never takes the server down. The reason goes to stdout, which is
        -- journald under systemd and the terminal under ./run.sh debug.
        local ok, status, payload, hdrs = pcall(handler, req, params)
        if not ok then
          print('handler error: ' .. m.method .. ' ' .. path .. ': ' .. tostring(status))
          fail(m.conn, 500, 'internal_error', 'the request failed; the reason is in the log')
        elseif status == 204 then
          -- A real DELETE answers no body; json-encoding a nil would send
          -- the four bytes "null" with a status that promises nothing.
          queue.push(http_out, { conn = m.conn, status = 204, body = '' })
        else
          -- A handler may return headers as a third value -- the waitlist's
          -- 429 carries retry-after this way. Every 401 the API answers is
          -- an auth challenge, so that header rides here rather than at
          -- each resolve_account call site.
          reply(m.conn, status, payload,
                hdrs or (status == 401 and AUTH_CHALLENGE or nil))
        end
      elseif allowed then
        -- Allow rides as a real header now (build10); the list stays in the
        -- body too, because a JSON client should not need to read headers
        -- to learn its options.
        fail(m.conn, 405, 'method_not_allowed',
             m.method .. ' is not allowed on ' .. path ..
             ' (allowed: ' .. table.concat(allowed, ', ') .. ')',
             { allow = table.concat(allowed, ', ') })
      else
        fail(m.conn, 404, 'no_route', 'no route for ' .. m.method .. ' ' .. path)
      end
    end
  end
  -- On timeout, loop. This is a daemon: it serves until it is stopped.
end
end

serve_forever()
